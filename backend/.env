PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────
# The Project ID alone (6a4604d88d1ba73ead556e06) isn't a full connection
# string — Atlas needs the cluster address + a database user/password too.
# In Atlas: Database > Connect > Drivers > copy the connection string, then
# paste it below with your real DB username/password filled in.
# It will look like:
#   mongodb+srv://<db_user>:<db_password>@<cluster-name>.mongodb.net/qno?retryWrites=true&w=majority
# Create the DB user under: Project 6a4604d88d1ba73ead556e06 > Database Access
# NEVER reuse your Atlas account password as the DB user password — create
# a separate, generated one there.
MONGO_URI=mongodb+srv://drrnaj812_db_user:yJeyREfnf70nJqMn@cluster0.82ua7r8.mongodb.net/?appName=Cluster0

# ── Auth tokens ──────────────────────────────────────────────────────────
# Two INDEPENDENT secrets, each 96 random hex characters (48 bytes) —
# generated locally, never reused between the two, so a leak of one never
# compromises the other. Regenerate your own before deploying anywhere
# beyond your own machine — never reuse these exact values in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=4dd8323c5d6c4b126c980e27e758528a2a4a2026dda7fbae427d271cb138fc5531db9e01c236197b93cb7c13a5a15e65
ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=5b4f9183276893241ecf881d4d7222125f1960a6e6c5aa30b8e095c041631c9925a0e6cbe8bd0f4801c152e180445528
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN_MS=2592000000

# Set to false ONLY for local http://localhost development. Must be true
# the moment this runs anywhere reachable over the internet — an httpOnly
# cookie without `secure` can be intercepted in plaintext over HTTP.
COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────────────
# Exact origin(s) allowed to call this API — comma-separated if you need
# more than one (e.g. a deployed frontend + local dev). Never use '*' here:
# credentials:true (required for the refresh cookie) is rejected by
# browsers when paired with a wildcard origin.
CORS_ORIGIN=http://localhost:5173
