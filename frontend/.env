# Backend Socket.io server URL (used by SocketContext)
VITE_SOCKET_URL=http://localhost:5000

# Use mock API data instead of a real backend (for frontend-only development)
# Set to false once the real backend is built and running
VITE_USE_MOCKS=true

# Razorpay public key (added later in Payments phase)
VITE_RAZORPAY_KEY_ID=